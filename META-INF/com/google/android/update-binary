#!/sbin/sh
# Universal installer: Magisk + KernelSU Next + APatch
# SystemUI JIT Crash Fix v1.0 by ridhzlabs
umask 022
OUTFD=$2
ZIPFILE=$3
[ -z "$OUTFD" ] && OUTFD=1

ui_print() {
  echo "ui_print $1" >> /proc/self/fd/$OUTFD
  echo "ui_print" >> /proc/self/fd/$OUTFD
}

ui_print " "
ui_print "  ______   ______ _____ _____ __  __ _   _ ___ "
ui_print " / ___\ \ / / ___|_   _| ____|  \/  | | | |_ _|"
ui_print " \___ \\\\ V /\___ \ | | |  _| | |\/| | | | || | "
ui_print "  ___) || |  ___) || | | |___| |  | | |_| || | "
ui_print " |____/ |_| |____/ |_| |_____|_|  |_|\___/|___|"
ui_print "      _ ___ _____   _____ _____  __"
ui_print "     | |_ _|_   _| |  ___|_ _\ \/ /"
ui_print "  _  | || |  | |   | |_   | | \  / "
ui_print " | |_| || |  | |   |  _|  | | /  \ "
ui_print "  \___/|___| |_|   |_|   |___/_/\_\\"
ui_print " "
ui_print "   v1.0  |  by ridhzlabs"
ui_print "   No more SystemUI restarts. No more lockscreen loops."
ui_print " "

MODID=systemui_jit_fix
MODPATH=${MODPATH:-/data/adb/modules/$MODID}

ui_print "- Target : $MODPATH"
rm -rf "$MODPATH"
mkdir -p "$MODPATH" || { ui_print "! Cannot create $MODPATH"; exit 1; }

ui_print "- Extracting module files..."
unzip -o "$ZIPFILE" -x 'META-INF/*' -d "$MODPATH" >/dev/null 2>&1
[ -f "$MODPATH/service.sh" ] || { ui_print "! Extraction failed"; exit 1; }

chmod 755 "$MODPATH/service.sh" "$MODPATH/action.sh" 2>/dev/null
chmod 644 "$MODPATH/module.prop" "$MODPATH/banner.png" 2>/dev/null

ui_print "- service.sh   : re-applies speed-compile on every boot"
ui_print "- action.sh    : manual re-apply from manager (Execute button)"
ui_print " "
ui_print "  Done! Reboot to activate."
ui_print "  Verify after reboot:"
ui_print "    dumpsys package com.android.systemui | grep status"
ui_print "  Expected: [status=speed]"
ui_print " "
exit 0
